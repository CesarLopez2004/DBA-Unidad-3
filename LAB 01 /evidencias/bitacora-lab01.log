2026-11-07 22:49:54.681 CST [22312] user=postgres db=DBA app=pgAdmin 4 - CONN:1567855 client=::1 LOG:  statement: CREATE OR REPLACE FUNCTION auditoria.fn_auditar_clientes()

	RETURNS TRIGGER AS $$

	BEGIN

	    IF (TG_OP = 'DELETE') THEN

	        INSERT INTO auditoria.historial_clientes (operacion, id_cliente, datos_anteriores, datos_nuevos)

	        VALUES ('DELETE', OLD.id, row_to_json(OLD), NULL);

	        RETURN OLD;

	    ELSIF (TG_OP = 'UPDATE') THEN

	        INSERT INTO auditoria.historial_clientes (operacion, id_cliente, datos_anteriores, datos_nuevos)

	        VALUES ('UPDATE', NEW.id, row_to_json(OLD), row_to_json(NEW));

	        RETURN NEW;

	    ELSIF (TG_OP = 'INSERT') THEN

	        INSERT INTO auditoria.historial_clientes (operacion, id_cliente, datos_anteriores, datos_nuevos)

	        VALUES ('INSERT', NEW.id, NULL, row_to_json(NEW));

	        RETURN NEW;

	    END IF;

	    RETURN NULL;

	END;

	$$ LANGUAGE plpgsql;

	
